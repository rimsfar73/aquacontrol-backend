<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- ===================================================== -->
    <!-- 1. IDENTIFICACION DEL PROYECTO                        -->
    <!-- ===================================================== -->

    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot administra las versiones de sus dependencias -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>aquacontrol-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>aquacontrol-backend</name>
    <description>
        API REST de AquaControl para temperaturas y flushing
    </description>

    <!-- ===================================================== -->
    <!-- 2. PROPIEDADES GENERALES                              -->
    <!-- ===================================================== -->

    <properties>

        <!-- Version de Java utilizada por el proyecto -->
        <java.version>21</java.version>

        <!-- Codificacion de los archivos fuente -->
        <project.build.sourceEncoding>
            UTF-8
        </project.build.sourceEncoding>

    </properties>

    <!-- ===================================================== -->
    <!-- 3. DEPENDENCIAS                                      -->
    <!-- ===================================================== -->

    <dependencies>

        <!-- ================================================ -->
        <!-- 3.1 API REST - SPRING WEB MVC                     -->
        <!-- ================================================ -->

        <!--
            Permite desarrollar controladores REST,
            exponer endpoints HTTP y procesar solicitudes
            GET, POST, PUT y DELETE.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>


        <!-- ================================================ -->
        <!-- 3.2 PERSISTENCIA - SPRING DATA JPA                -->
        <!-- ================================================ -->

        <!--
            Permite trabajar con entidades JPA,
            repositorios y operaciones de persistencia
            utilizando Hibernate.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Driver JDBC para conectar Spring Boot
            con la base de datos PostgreSQL.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>


        <!-- ================================================ -->
        <!-- 3.3 VALIDACION DE DATOS                           -->
        <!-- ================================================ -->

        <!--
            Permite validar DTO y datos de entrada
            mediante anotaciones como @NotNull,
            @NotBlank, @Size y @Valid.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>


        <!-- ================================================ -->
        <!-- 3.4 SEGURIDAD Y AUTENTICACION                     -->
        <!-- ================================================ -->

        <!--
            Spring Security permite configurar
            autenticacion, autorizacion y restricciones
            de acceso segun los roles del usuario.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
            OAuth2 Resource Server permite validar
            tokens JWT Bearer enviados por los clientes.

            AquaControl utiliza los roles:
            - OPERARIO
            - SUPERVISOR
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>
                spring-boot-starter-security-oauth2-resource-server
            </artifactId>
        </dependency>


        <!-- ================================================ -->
        <!-- 3.5 DOCUMENTACION - OPENAPI / SWAGGER             -->
        <!-- ================================================ -->

        <!--
            Springdoc genera documentacion OpenAPI
            a partir de los controladores REST.

            Swagger UI permite visualizar y probar
            los endpoints desde el navegador.

            URL de desarrollo:
            http://localhost:8080/swagger-ui/index.html

            Especificacion JSON:
            http://localhost:8080/v3/api-docs

            Las operaciones protegidas siguen
            requiriendo autenticacion JWT.
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>


        <!-- ================================================ -->
        <!-- 3.6 HERRAMIENTAS DE DESARROLLO                    -->
        <!-- ================================================ -->

        <!--
            DevTools facilita el desarrollo local
            mediante reinicios automaticos al detectar
            determinados cambios en el proyecto.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--
            Lombok reduce codigo repetitivo mediante
            anotaciones para constructores, getters,
            setters y otras funcionalidades.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>


        <!-- ================================================ -->
        <!-- 3.7 DEPENDENCIAS PARA PRUEBAS                     -->
        <!-- ================================================ -->

        <!--
            Herramientas para probar repositorios JPA
            y operaciones de persistencia.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Herramientas para probar reglas de seguridad,
            autenticacion y autorizacion.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Herramientas para probar validaciones
            y restricciones de datos.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Herramientas para probar controladores
            y endpoints HTTP de Spring MVC.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!-- ===================================================== -->
    <!-- 4. CONFIGURACION DE COMPILACION                       -->
    <!-- ===================================================== -->

    <build>

        <plugins>

            <!-- ============================================ -->
            <!-- 4.1 MAVEN COMPILER PLUGIN                    -->
            <!-- ============================================ -->

            <!--
                Compila el proyecto utilizando Java 21.

                Configura Lombok como procesador
                de anotaciones durante la compilacion.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>

                    <release>${java.version}</release>

                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>

                </configuration>
            </plugin>


            <!-- ============================================ -->
            <!-- 4.2 JACOCO - COBERTURA DE PRUEBAS            -->
            <!-- ============================================ -->

            <!--
                JaCoCo permite medir la cobertura
                de codigo durante las pruebas.

                prepare-agent:
                prepara el agente de cobertura.

                report:
                genera el informe durante la fase verify.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>

                <executions>

                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>

                </executions>
            </plugin>


            <!-- ============================================ -->
            <!-- 4.3 SPRING BOOT MAVEN PLUGIN                 -->
            <!-- ============================================ -->

            <!--
                Permite ejecutar y empaquetar
                la aplicacion Spring Boot.

                Lombok se excluye del artefacto
                ejecutable porque se utiliza
                durante la compilacion.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>

            </plugin>

        </plugins>

    </build>

</project>
